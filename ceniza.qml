<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis version="3.44" styleCategories="Symbology">
  <pipe>
    <rasterrenderer type="paletted" band="1" opacity="1" alphaBand="-1">
      <colorPalette>
        <paletteEntry value="0" color="#000000" alpha="0" label="sin ceniza"/>
        <paletteEntry value="1" color="#ff0000" alpha="255" label="ceniza confirmada"/>
        <paletteEntry value="2" color="#ffa500" alpha="255" label="probabilidad alta"/>
        <paletteEntry value="3" color="#ffff00" alpha="255" label="probabilidad baja"/>
        <paletteEntry value="6" color="#a0a0a0" alpha="255" label="nube: ceniza no detectable"/>
      </colorPalette>
    </rasterrenderer>
  </pipe>
</qgis>
